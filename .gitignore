# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local npm cache used during sandboxed installs
/.npm-cache/
/.npm-logs/

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.artifact-runtime/
/build/
*.tsbuildinfo
*.sqlite*
*.sqlite3
*.db
*.db-*

# Cloudflare / 开发环境变量（真实值绝不能入库）
.dev.vars
.dev.vars.*

# 运行时数据与备份（数据库、附件、导出、备份一律放在仓库外）
/data/
/uploads/
/storage/
/backups/
/dump/
*.dump
*.bak
*.sql.gz
docker-compose.override.yml

# 部署目录里的真实环境变量（仅允许提交脱敏的 .env.example）
/deploy/.env
/deploy/.env.*
!/deploy/.env.example
